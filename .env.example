# --- Server ---
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://www.sareegrace.in,https://saree-grace-frontend.vercel.app

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/saree_grace?retryWrites=true&w=majority
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/saree_grace_test

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google SSO ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_FOLDER=saree-grace

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret


# --- Email (SMTP, via nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password-or-app-password
EMAIL_FROM_NAME=Saree Grace
EMAIL_FROM_ADDRESS=no-reply@sareegrace.com

# --- Customer-facing links & support (used in transactional emails) ---
APP_URL=https://www.sareegrace.in
SUPPORT_EMAIL=support@sareegrace.com
ABANDONED_CART_DELAY_HOURS=24

# --- Password reset ---
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# --- Signup email OTP ---
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Shared secret (>= 32 chars, e.g. `openssl rand -hex 32`) also set as INTERNAL_API_KEY on the
# storefront (Vercel, server-only). Its server-side fetches skip the global per-IP rate limit.
INTERNAL_API_KEY=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=30

# --- Admin bootstrap (seed script) ---
SEED_ADMIN_EMAIL=admin@sareegrace.com
SEED_ADMIN_PASSWORD=ChangeMe123!
